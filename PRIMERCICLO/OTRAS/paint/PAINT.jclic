    </container>
    <window bgColor="0xC0C0C0" border="true" />
   </settings>
   <cells rows="7" cols="7" border="false" image="pantalla.gif" id="primary">
    <style>
     <font family="Arial" size="15" />
     <color foreground="0xFFFFFF" background="0x0000A0" />
    </style>
    <shaper class="@Holes" cols="7" rows="7" scaleX="7.0" scaleY="7.0">
     <enclosing>
      <shape>rectangle:0,0,7,7</shape>
     </enclosing>
     <shape>rectangle:1,0,5,1</shape>
     <shape>rectangle:6,0,1,1</shape>
     <shape>M:0,1|L:0,2|L:0,3|L:0,4|L:0,5|L:0,6|L:1,6|L:1,5|L:1,4|L:1,3|L:1,2|L:1,1|X</shape>
     <shape>M:1,1|L:1,2|L:1,3|L:1,4|L:1,5|L:6,5|L:6,4|L:6,3|L:6,2|L:6,1|X</shape>
     <shape>M:6,1|L:6,2|L:6,3|L:6,4|L:6,5|L:6,6|L:7,6|L:7,5|L:7,4|L:7,3|L:7,2|L:7,1|X</shape>
     <shape>rectangle:1,5,5,1</shape>
     <shape>rectangle:1,6,1,1</shape>
     <shape>rectangle:2,6,4,1</shape>
    </shaper>
    <ids>1 5 0 3 6 7 4 2</ids>
   </cells>
   <cells rows="2" cols="4" cellWidth="251.0" cellHeight="100.0" border="false" id="secondary">
    <style>
     <font family="Arial" size="15" />
     <color foreground="0xFFFFFF" background="0x0000A0" />
    </style>
    <shaper class="@Rectangular" cols="4" rows="2" />
