<JClicProject name="paint" version="0.1.3">
 <settings>
  <title>¿Cuánto sabés de Paint?</title>
  <revision description="created" date="5/3/05" />
  <author name="Alejandro Dellafiore" mail="adellafiore@hotmail.com" url="www.argenclic.com.ar" organization="ArgenClic" />
  <description>
   <p>Paquete que repasa las herramientas de PaintBrush</p>
  </description>
  <descriptors area="Informática" level="Inicial, EGB" />
  <meta_langs>es</meta_langs>
  <descriptions>
   <description language="es">
    <p>Paquete que repasa las herramientas de PaintBrush</p>
   </description>
  </descriptions>
  <license type="by-nc-sa" url="https://creativecommons.org/licenses/by-nc-sa/4.0" />
 </settings>
 <sequence>
  <item id="paint.pac" name="caratula.ass">
   <jump action="STOP" id="back" />
