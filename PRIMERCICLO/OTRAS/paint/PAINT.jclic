  <activity class="@textGrid.WordSearch" name="sopapain.sop">
   <messages>
    <cell type="initial">
     <style>
      <font family="Tahoma" size="31" />
      <color foreground="0xFFFFFF" background="0x800040" inactive="0xC0C0C0" alternative="0xC0C0C0" />
     </style>
     <p>BUSCA EL NOMBRE DE 10 HERRAMIENTAS DEL PAINT</p>
    </cell>
    <cell type="final">
     <style>
      <font family="Tahoma" size="31" />
      <color foreground="0xFFFFFF" background="0x800040" inactive="0xC0C0C0" alternative="0xC0C0C0" />
     </style>
     <p>¡ QUÉ GRAN ESFUERZO !</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <helpWindow showSolution="true" />
    <container bgColor="0xC0C0C0">
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xC0C0C0" border="true" />
   </settings>
   <textGrid rows="18" columns="10" cellWidth="30.0" cellHeight="30.0" border="true">
    <style>
     <font family="Tahoma" size="32" />
     <color foreground="0x0000A0" background="0xFFFFFF" />
    </style>
    <text>
     <row>*RELLENO-COLOR****</row>
     <row>***A********V***G*</row>
     <row>***PINCEL***A***O*</row>
     <row>***I****I***L***T*</row>
     <row>***Z****N**GOMA*E*</row>
     <row>********E*******R*</row>
     <row>****RECTANGULO**O*</row>
     <row>******************</row>
     <row>**AEROGRAFO*******</row>
     <row>********CURVA*****</row>
    </text>
   </textGrid>
   <clues>
    <clue id="0">RELLENO-COLOR</clue>
    <clue id="1">LAPIZ</clue>
    <clue id="2">PINCEL</clue>
    <clue id="3">OVALO</clue>
    <clue id="4">GOMA</clue>
    <clue id="5">GOTERO</clue>
    <clue id="6">RECTANGULO</clue>
    <clue id="7">AEROGRAFO</clue>
    <clue id="8">CURVA</clue>
    <clue id="9">LINEA</clue>
   </clues>
  </activity>
  <activity class="@text.FillInBlanks" name="textopai.txa" autoJump="true" forceOkToAdvance="true">
   <messages>
    <cell type="initial">
     <style>
      <font family="Tahoma" size="32" />
      <color foreground="0xFF0000" />
     </style>
     <p>ELIGE DE LA LISTA LA HERRAMIENTA CORRECTA</p>
    </cell>
    <cell type="final">
     <style>
      <font family="Tahoma" size="32" />
      <color foreground="0xFF0000" />
     </style>
     <p>¡Buenísimo!</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <container bgColor="0xFF8080">
     <counters time="false" actions="true" score="true" />
    </container>
    <window bgColor="0xC0C0C0" transparent="true" border="true">
     <size width="540" height="350" />
    </window>
   </settings>
   <document>
    <style name="target" base="default" background="0xFFFFFF" target="true" foreground="0x0000FF" />
    <style name="default" background="0xFFFFFF" foreground="0x000000" tabWidth="12" bold="false" size="15" family="Arial" italic="false" />
    <style name="targetError" base="target" background="0xFF0000" foreground="0xFFFFFF" />
    <section>
     <p background="0xFFFFFF" name="default" foreground="0x000000" family="Arial" size="15" bold="false" italic="false">
      <cell txtAlign="left,middle" imgAlign="left,middle" width="520" height="60" border="false">
       <style>
        <font family="Arial" size="20" bold="true" />
        <color foreground="0xFF0000" background="0xFFFFFF" inactive="0xFFFFFF" alternative="0xFFFFFF" />
       </style>
       <p>        Indica la herramienta correcta a utilizar:</p>
      </cell>
     </p>
