<JClicProject name="yosise" version="0.1.3">
 <settings>
  <title>Yo sí sé</title>
  <revision description="Adaptación para JClic" date="1/4/05">
   <author name="María Eugenia Núñez" mail="eugenunez@yahoo.com.ar" organization="&quot;Proyecto ArgenClic&quot;" />
  </revision>
  <author name="Nora del Carmen Marzetti - Pujato, Prov. de Santa Fe, Argentina" mail="nora_m@dat1.net.ar" />
  <organization name="Escuela Nº 227" url="http://escuela227.trabaja.net.ar" city="Pujato" country="Argentina" state="Pcia. de Santa Fe" />
  <language>es</language>
  <description>
   <p>Programa de preguntas y respuestas de interés general. </p>
   <p>Cada pregunta tiene 10 opciones de las cuales siempre sólo cinco son las correctas.</p>
   <p>Son tres programas con distintos grados de dificultad, con </p>
   <p>actividades adaptadas a los contenidos de cada uno de los ciclos</p>
   <p>de E.G.B.</p>
  </description>
  <descriptors level="EGB1 / EGB2 / EGB3" />
  <meta_langs>es</meta_langs>
  <descriptions>
   <description language="es">
    <p>Programa de preguntas y respuestas de interés general. </p>
    <p>Cada pregunta tiene 10 opciones de las cuales siempre sólo cinco son las correctas.</p>
    <p>Son tres programas con distintos grados de dificultad, con </p>
    <p>actividades adaptadas a los contenidos de cada uno de los ciclos</p>
    <p>de E.G.B.</p>
   </description>
  </descriptions>
  <license type="by-nc-sa" url="https://creativecommons.org/licenses/by-nc-sa/4.0" />
