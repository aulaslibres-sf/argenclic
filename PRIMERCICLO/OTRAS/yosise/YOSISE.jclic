     <font family="Arial" size="20" />
     <color background="0xBDDEFF" inactive="0x0000A0" alternative="0x0000A0" />
    </style>
    <shaper class="@Rectangular" cols="1" rows="3" />
    <cell>
     <media type="RUN_CLIC_PACKAGE" level="1" file="yosise1.pac" />
