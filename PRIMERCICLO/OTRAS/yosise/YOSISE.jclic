      <font family="Arial" size="20" />
      <color background="0x0080FF" inactive="0x0000A0" alternative="0x0000A0" />
     </style>
    </cell>
   </messages>
   <settings margin="8" report="false">
    <container bgColor="0xC0C0C0">
     <image name="fondo.gif" tiled="true" />
