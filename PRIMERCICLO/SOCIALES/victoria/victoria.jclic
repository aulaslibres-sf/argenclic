  <activity class="@text.FillInBlanks" name="puente.txa">
   <messages>
    <cell type="initial">
     <style>
      <color foreground="0xFFFFFF" background="0x0000FF" />
     </style>
     <p>QUÉ NOS UNE????</p>
    </cell>
    <cell type="final">
     <style>
      <color foreground="0xFFFFFF" background="0x0000FF" />
     </style>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <container bgColor="0x0080FF">
     <image name="fondop1.gif" tiled="true" />
     <counters time="false" actions="false" score="false" />
    </container>
    <window bgColor="0xC0C0C0" border="true">
     <size width="690" height="420" />
    </window>
   </settings>
   <document>
    <style name="target" base="default" background="0xC0C0C0" foreground="0x0000FF" target="true" />
    <style name="default" background="0xFFFFFF" family="Courier New" bold="true" size="17" foreground="0x000000" tabWidth="16" italic="false" />
    <style name="targetError" base="target" background="0xFF0000" foreground="0xFFFFFF" />
    <section>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>                                                 EL PUENTE</text>
     </p>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false" />
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>La conexión Victoria – Rosario vincula las ciudades homónimas, cruzando el valle de inundación del Río Paraná.</text>
     </p>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false" />
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>La cabecera oeste – Rosario: </text>
     </p>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>La conexión, luego de cruzar el Río Paraná, entra a territorio santafesino en viaducto, cruza la Ruta Nacional Nº 11 (Bvrd. Rondeau) con sobrenivel, y enlaza con la Av. de circunvalación de Rosario A – 008, entre la citada ruta y las vías de ferrocarril PCNCA.</text>
     </p>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false" />
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>La cabecera este – Victoria: la conexión intercepta la Ruta Provincial Nº 11, a 760 m. al norte del Bvrd. Sarmiento.</text>
     </p>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false" />
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>Longitud total del proyecto: 59,4 Km.</text>
     </p>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false" />
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>Puentes: 12.282 m.</text>
     </p>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false" />
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>Terraplenes: 47.149 m.</text>
     </p>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false" />
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>Longitud de puentes: puente principal: 608 m.</text>
     </p>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false" />
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>Viaducto acceso oeste (lado Rosario): 1.122 m.</text>
     </p>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false" />
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>Viaducto acceso este (lado Victoria): 2.368 m.</text>
     </p>
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false" />
     <p family="Courier New" background="0xFFFFFF" size="17" bold="true" foreground="0x000000" name="default" italic="false">
      <text>Puentes en zonas de islas: 8184 m. incluyendo seis cursos navegables.</text>
     </p>
    </section>
   </document>
   <evaluator class="@ComplexEvaluator" />
  </activity>
