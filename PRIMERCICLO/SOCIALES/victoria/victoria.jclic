    <section>
     <p background="0xFF8000" family="Arial" bold="false" size="17" foreground="0x000000" name="default" italic="false">
      <text>                                   LA CIUDAD</text>
     </p>
     <p background="0xFF8000" family="Arial" bold="false" size="17" foreground="0x000000" name="default" italic="false" />
     <p background="0xFF8000" family="Arial" bold="false" size="17" foreground="0x000000" name="default" italic="false">
      <text>Está ubicada al </text>
      <target>
       <answer>Sudoeste</answer>
       <optionList>
        <option>Sudeste</option>
        <option>Sudoeste</option>
        <option>Noreste</option>
       </optionList>
       <text>Sudoeste</text>
      </target>
      <text> de la provincia en el comienzo del imponente Delta del </text>
      <target>
       <answer>Paraná</answer>
       <optionList>
        <option>Tigre</option>
        <option>Paraná</option>
        <option>Amazonas</option>
       </optionList>
