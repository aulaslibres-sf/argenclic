<?xml version="1.0" encoding="UTF-8"?>
<JClicProject name="silabita" version="0.1.3">
 <settings>
  <title>Silabitas</title>
  <revision description="Adaptación para JClic" date="1/4/05">
   <author name="María Eugenia Núñez" mail="eugenunez@yahoo.com.ar" organization="&quot;Proyecto ArgenClic&quot;" />
  </revision>
  <author name="María Elena Abalo - Ushuaia, Tierra del Fuego" mail="sosaba@infovia.com.ar" />
  <language>es</language>
  <description>
   <p>Paquete de actividades destinado a segundo año de educación primaria. En él se trabaja la separación silábica de las palabras y el orden alfabético.</p>
  </description>
  <descriptors area="Lengua" level="EGB1" />
  <meta_langs>es</meta_langs>
  <descriptions>
   <description language="es">
    <p>Paquete de actividades destinado a segundo año de educación primaria. En él se trabaja la separación silábica de las palabras y el orden alfabético.</p>
   </description>
  </descriptions>
  <license type="by-nc-sa" url="https://creativecommons.org/licenses/by-nc-sa/4.0" />
 </settings>
 <sequence>
  <item id="silabita.pac" name="presenta.ass">
   <description>
    <p>VARIAS ACTIVIDADES CON SEPARACIÓN DE SÍLABAS PARA 2º GRADO</p>
   </description>
   <jump action="STOP" id="back" />
  </item>
  <item name="armapal.ass" />
  <item name="armapal1.ass" />
  <item name="sepsil1.ass" />
  <item name="sepsil2.ass" />
