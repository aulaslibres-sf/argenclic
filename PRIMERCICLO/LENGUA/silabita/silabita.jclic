 <activities>
  <activity class="@puzzles.DoublePuzzle" name="2sil.puz" code="">
   <description />
   <messages>
    <cell type="initial">
     <style>
      <font family="Arial" size="19" bold="true" />
      <color background="0x8080FF" />
     </style>
     <p>ARMÁ LAS PALABRAS DE DOS SONIDOS. !ACORDATE DEL ABECEDARIO!.</p>
    </cell>
    <cell type="final">
     <style>
      <font family="Arial" size="19" bold="true" />
      <color background="0x8080FF" />
     </style>
     <p>¡GUAU!</p>
    </cell>
   </messages>
   <settings margin="8" dragCells="true" report="true" reportActions="false">
    <container bgColor="0xC0C0C0">
     <image name="barquito.gif" tiled="true" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xC0C0C0" border="true" />
   </settings>
   <cells rows="5" cols="2" cellWidth="350.0" cellHeight="260.0" border="true">
    <style borderStroke="0.7" markerStroke="5.0">
     <font family="Arial" size="17" bold="true" />
     <color background="0x00FFFF" />
    </style>
    <shaper class="@Rectangular" cols="2" rows="5" />
    <cell>
     <p>ÁR</p>
    </cell>
    <cell>
     <p>BOL</p>
    </cell>
    <cell>
     <p>BO</p>
    </cell>
    <cell>
     <p>TE</p>
    </cell>
    <cell>
     <p>CO</p>
    </cell>
    <cell>
