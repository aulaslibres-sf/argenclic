  <activity class="@text.WrittenAnswer" name="sepsil2.ass" code="">
   <description />
   <messages>
    <cell type="initial">
     <style>
      <font family="Arial" size="20" bold="true" />
      <color background="0xFF0000" />
     </style>
     <p>ESCRIBE ESTAS OTRAS, IGUAL QUE ANTES.</p>
    </cell>
