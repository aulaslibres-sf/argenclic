     <font family="Arial" size="19" bold="true" />
     <color background="0x80FFFF" inactive="0x0000FF" alternative="0x0000FF" />
    </style>
    <shaper class="@Rectangular" cols="1" rows="3" />
   </cells>
   <scramble times="31" primary="true" secondary="true" />
   <layout position="AB" />
  </activity>
