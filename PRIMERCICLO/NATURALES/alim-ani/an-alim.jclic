 <activities>
  <activity class="@associations.ComplexAssociation" name="animal.ass">
   <messages>
    <cell type="initial">
     <style>
      <font family="Arial" size="19" bold="true" />
      <color background="0x80FFFF" inactive="0x0000FF" alternative="0x0000FF" />
     </style>
     <p>CLASIFICA A ESTOS ANIMALES SEGÚN DE QUÉ SE ALIMENTAN</p>
    </cell>
    <cell type="final">
     <style>
      <font family="Arial" size="19" bold="true" />
      <color background="0x80FFFF" inactive="0x0000FF" alternative="0x0000FF" />
     </style>
     <p>¡MUY BIEN HECHO!</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <container bgColor="0xFFFFC6">
     <counters time="false" actions="true" score="true" />
    </container>
    <window bgColor="0xFFFFC6" border="true" />
   </settings>
   <cells rows="3" cols="3" border="true" image="animales.gif" id="primary">
    <style>
     <font family="Arial" size="19" bold="true" />
     <color background="0x80FFFF" inactive="0x0000FF" alternative="0x0000FF" />
    </style>
    <shaper class="@Rectangular" cols="3" rows="3" />
    <ids>0 1 2 1 0 0 0 0 2</ids>
   </cells>
   <cells rows="3" cols="1" border="true" image="cartel1.gif" id="secondary">
