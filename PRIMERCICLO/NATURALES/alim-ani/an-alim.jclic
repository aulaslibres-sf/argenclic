<?xml version="1.0" encoding="UTF-8"?>
<JClicProject name="an-alim" version="0.1.3">
 <settings>
  <title>Alimentación de animales</title>
  <revision description="created" date="8/12/09" />
  <author name="María Isabel Presso" rol="Maestra Especializada en Informática Educativa" organization="Escuela Nº 1- Neuquén">
   <comments>
    <p>*Pantallas de Información acerca de los animales herbívoros, carnívoros </p>
    <p>y omnívoros.*</p>
    <p>*Ejercicios de identificación, relación, sopa de letras, rompecabezas y </p>
    <p>actividades de texto mínimo.*</p>
   </comments>
  </author>
  <language>es</language>
  <descriptors area="Ciencias Naturales" level="Primaria">carnivoros, omnivoros, herbívoros, animales, alimentación</descriptors>
  <meta_langs>es</meta_langs>
  <descriptions>
   <description language="es" />
  </descriptions>
  <license type="by-nc-sa" url="https://creativecommons.org/licenses/by-nc-sa/4.0" />
 </settings>
