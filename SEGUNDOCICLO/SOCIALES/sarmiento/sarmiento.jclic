  <activity class="@panels.Identify" name="F_00" code="">
   <description />
   <messages>
    <cell type="initial">
     <style shadow="true">
      <font family="Arial" size="26" bold="true" />
      <color foreground="0x0066CC" background="0xFFFFFF" shadow="0xFFFFFF" />
      <gradient source="0x00A3FF" dest="0xFFFFFF" angle="348" />
     </style>
     <p>Clic en la casa de Sarmiento para conocer a su familia</p>
    </cell>
    <cell type="final">
     <style shadow="true">
      <font family="Arial" size="26" bold="true" />
      <color foreground="0x0066FF" shadow="0xFFFFFF" />
      <gradient source="0x99CCFF" dest="0xFFFFFF" angle="304" />
     </style>
     <p>Luego de los saludos, seguimos trabajando...</p>
    </cell>
   </messages>
   <settings margin="8" report="false">
    <container bgColor="0xEAF2F9">
     <gradient source="0xE6F7FA" dest="0xFFFFFF" angle="317" />
     <image name="fondo.png" tiled="false" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFFFFF" transparent="true" border="false" />
   </settings>
   <cells rows="4" cols="1" border="false" image="Casa_N.jpg" id="primary">
    <style transparent="true" />
    <shaper class="@Rectangular" cols="1" rows="4" />
    <ids>1 1 1 1</ids>
   </cells>
   <cells rows="1" cols="1" cellWidth="50.0" cellHeight="30.0" border="false" id="solvedPrimary">
    <style shadow="true" transparent="true">
     <font family="Arial" size="26" />
     <color foreground="0x0066FF" shadow="0xFFFFCC" />
    </style>
    <shaper class="@Rectangular" cols="1" rows="4" />
    <cell>
     <p>Domingo Faustino Sarmiento, hijo de José Clemente Quiroga Sarmiento y Paula</p>
     <p>Albarracín, hermano de Procesa Sarmiento de Leloir. </p>
    </cell>
    <cell>
     <p>Su verdadero nombre era Faustino Valentín Sarmiento. </p>
    </cell>
    <cell>
     <p>Su única hija se llamó Ana </p>
     <p>Faustina. </p>
    </cell>
    <cell>
     <p>Se casa en Chile con la viuda Benita Martínez Pastoriza y adopta a su hijo Dominguito.</p>
    </cell>
   </cells>
   <scramble times="31" primary="false" />
  </activity>
  <activity class="@panels.Explore" name="F_01" code="">
   <description />
   <messages>
    <cell type="initial">
     <style shadow="true">
