   </settings>
   <cells rows="2" cols="4" cellWidth="150.0" cellHeight="100.0" border="false">
    <style shadow="true">
     <color foreground="0x0066CC" background="0xFFFFFF" shadow="0xFFFFCC" />
    </style>
    <shaper class="@Rectangular" cols="4" rows="2" />
    <cell>
     <p>"Cuando </p>
    </cell>
    <cell>
     <p>los hombres </p>
    </cell>
    <cell>
     <p>honrados </p>
    </cell>
    <cell>
     <p>se van a su casa, </p>
    </cell>
    <cell>
     <p>los pillos </p>
    </cell>
    <cell>
     <p>entran</p>
    </cell>
    <cell>
     <p> en la de </p>
    </cell>
    <cell>
     <p>gobierno"</p>
    </cell>
   </cells>
   <scramble times="31" />
  </activity>
