  <activity class="@text.FillInBlanks" name="V_05" code="">
   <description />
   <messages>
    <cell type="previous">
     <style />
    </cell>
    <cell type="initial">
     <style shadow="true">
      <font family="Arial" size="26" bold="true" />
      <color foreground="0x0066CC" background="0xFFFFFF" shadow="0xFFFFFF" />
      <gradient source="0x00A3FF" dest="0xFFFFFF" angle="348" />
     </style>
     <p>Elige la opción correcta para completar el texto</p>
    </cell>
    <cell type="final">
     <style shadow="true">
      <font family="Arial" size="26" bold="true" />
      <color foreground="0x0066CC" shadow="0xFFFFFF" />
      <gradient source="0x00A3FF" dest="0xFFFFFF" angle="348" />
     </style>
     <p>Bravo</p>
    </cell>
    <cell type="finalError">
     <style shadow="true">
      <font family="Arial" size="24" italic="true" />
      <color foreground="0x0066FF" shadow="0xFFFFFF" />
      <gradient source="0x00A3FF" dest="0xFFFFFF" angle="348" />
     </style>
     <p>Lee con atención (clic en el texto al finalizar)</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <container bgColor="0xEAF2F9">
     <gradient source="0xE6F7FA" dest="0xFFFFFF" angle="317" />
     <image name="fondo.png" tiled="false" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFFFFF" transparent="true" border="true">
     <size width="600" height="450" />
    </window>
   </settings>
   <prevScreen maxTime="30" />
   <document>
    <style name="default" foreground="0x0033FF" tabWidth="12" size="16" italic="false" family="Arial" background="0xEAFAFA" bold="false" />
    <style name="target" base="default" foreground="0x0000FF" target="true" background="0xFFFFFF" />
    <style name="targetError" base="target" foreground="0xFF0000" />
    <section>
     <p family="Arial" Alignment="1" background="0xFFFFFF">
      <cell width="400" height="40">
       <style shadow="true" borderStroke="0.7" markerStroke="5.0">
        <font family="Arial" size="26" />
        <color foreground="0x0066CC" shadow="0xFFFFFF" />
        <gradient source="0x00A3FF" dest="0xFFFFFF" angle="348" />
       </style>
       <p>Algunas obras en educación</p>
      </cell>
     </p>
     <p family="Arial" Alignment="1" background="0xFFFFFF" />
     <p family="Arial" Alignment="1" background="0xFFFFFF">
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF">Sarmiento realizó una importante contribución al </text>
      <target>
       <answer>saber</answer>
       <optionList>
        <option>saber</option>
        <option>aprender</option>
        <option>ignorar</option>
        <option>juego</option>
       </optionList>
       <text>saber</text>
      </target>
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF"> gracias al aporte que realizó como promotor del progreso </text>
      <target>
       <answer>científico</answer>
       <optionList>
        <option>político</option>
        <option>económico</option>
        <option>científico</option>
        <option>social</option>
       </optionList>
       <info mode="onError">
        <cell width="100" height="40">
         <p>relativo a las ciencias</p>
        </cell>
       </info>
       <text>científico</text>
      </target>
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF"> y una acción y prédica constante a favor de la </text>
      <target>
       <answer>enseñanza</answer>
       <optionList>
        <option>vagancia</option>
        <option>enseñanza</option>
        <option>democracia</option>
       </optionList>
       <info mode="onError">
        <cell width="100" height="40">
         <p>la función del maestro</p>
        </cell>
       </info>
       <text>enseñanza</text>
      </target>
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF"> y creación de instituciones </text>
      <target>
       <answer>científicas</answer>
       <optionList>
        <option>políticas</option>
        <option>sociales</option>
        <option>metafísicas</option>
        <option>científicas</option>
       </optionList>
       <text>científicas</text>
      </target>
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF"> y culturales.</text>
     </p>
     <p family="Arial" Alignment="1" background="0xFFFFFF" />
     <p family="Arial" Alignment="1" background="0xFFFFFF">
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF">Durante su presidencia se inició la formación profesional de maestros. Creó </text>
      <target>
       <answer>escuelas normales</answer>
       <optionList>
        <option>escuelas normales</option>
        <option>naves espaciales</option>
        <option>provincias nuevas</option>
       </optionList>
       <text>escuelas normales</text>
      </target>
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF"> anexas a los </text>
      <target>
       <answer>colegios</answer>
       <optionList>
        <option>comercios</option>
        <option>edificios</option>
        <option>colegios</option>
       </optionList>
       <text>colegios</text>
      </target>
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF"> nacionales de Corrientes y de Concepción del Uruguay en 1869 y de Paraná en 1870. </text>
     </p>
     <p family="Arial" Alignment="1" background="0xFFFFFF">
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF">Fundó el Colegio Militar, la Escuela Naval, y escuelas de arboricultura y agronomía en San Juan, en Mendoza, y más tarde en Tucumán y Salta.</text>
     </p>
     <p family="Arial" Alignment="1" background="0xFFFFFF" />
     <p family="Arial" Alignment="1" background="0xFFFFFF">
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF">Creo escuelas </text>
      <target>
       <answer>primarias</answer>
       <optionList>
        <option>iniciales</option>
        <option>primarias</option>
        <option>secundarias</option>
        <option>terciarias</option>
       </optionList>
       <text>primarias</text>
      </target>
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF"> en varias provincias e importó de </text>
      <target>
       <answer>Europa</answer>
       <optionList>
        <option>Asia</option>
        <option>Africa</option>
        <option>Europa</option>
        <option>Oceanía</option>
       </optionList>
       <text>Europa</text>
      </target>
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF"> gabinetes de ciencias y colecciones de historia </text>
      <target>
       <answer>natural</answer>
       <optionList>
        <option>aburridas</option>
        <option>natural</option>
        <option>aborigen</option>
       </optionList>
       <text>natural</text>
      </target>
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF">.</text>
     </p>
     <p family="Arial" Alignment="1" background="0xFFFFFF" />
     <p family="Arial" Alignment="1" background="0xFFFFFF">
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF">Por su iniciativa se crearon en la región </text>
      <target>
       <answer>cuyana</answer>
       <optionList>
        <option>patagónica</option>
        <option>mesopotámica</option>
        <option>cuyana</option>
       </optionList>
       <text>cuyana</text>
      </target>
      <text foreground="0x0033FF" size="16" family="Arial" bold="false" background="0xFFFFFF"> las cátedras de mineralogía en los Colegios nacionales de Catamarca y de San Juan, que se convertirían en 1876 en la Escuela de Ingenieros de San Juan.</text>
     </p>
     <p family="Arial" background="0xFFFFFF" />
    </section>
   </document>
   <evaluator class="@ComplexEvaluator" />
  </activity>
