     </style>
     <p>¡¡¡Muy Bien!!!             (Clic aquí para volver a empezar)</p>
    </cell>
   </messages>
   <settings margin="8" dragCells="true" report="true" reportActions="false">
    <container bgColor="0xEAF2F9">
     <gradient source="0xE6F7FA" dest="0xFFFFFF" angle="317" />
     <image name="fondo.png" tiled="false" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFFFFF" transparent="true" border="false" />
   </settings>
   <cells rows="2" cols="4" cellWidth="166.0" cellHeight="100.0" border="true">
    <style shadow="true">
     <font family="Arial" size="17" bold="true" />
     <color foreground="0x0066CC" background="0xFFFFFF" shadow="0xFFFFCC" inactive="0xFFFFFF" alternative="0xFFFFFF" />
    </style>
    <shaper class="@Rectangular" cols="4" rows="2" />
    <cell>
     <p>"El buen salario, </p>
    </cell>
    <cell>
     <p>la comida abundante,</p>
    </cell>
    <cell>
     <p> el buen vestir </p>
    </cell>
    <cell>
     <p>y la libertad </p>
    </cell>
    <cell>
     <p>educan</p>
    </cell>
    <cell>
     <p> a un adulto</p>
    </cell>
    <cell>
