  <activity class="@puzzles.ExchangePuzzle" name="V_02" code="">
   <description />
   <messages>
    <cell type="initial">
     <style shadow="true">
      <font family="Arial" size="26" bold="true" />
      <color foreground="0x0066CC" background="0xFFFFFF" shadow="0xFFFFFF" />
      <gradient source="0x00A3FF" dest="0xFFFFFF" angle="348" />
     </style>
     <p>Ordena los acontecimientos de su vida</p>
    </cell>
    <cell type="final">
     <style shadow="true">
      <font family="Arial" size="26" bold="true" />
      <color foreground="0x0066CC" shadow="0xFFFFFF" />
      <gradient source="0x00A3FF" dest="0xFFFFFF" angle="348" />
     </style>
     <p>¡¡¡Qué bien!!!</p>
    </cell>
   </messages>
   <settings margin="8" dragCells="true" report="true" reportActions="false">
    <container bgColor="0xEAF2F9">
     <gradient source="0xE6F7FA" dest="0xFFFFFF" angle="317" />
     <image name="flechas_fondo.png" tiled="false" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFFFFF" transparent="true" border="false" />
   </settings>
   <cells rows="1" cols="6" cellWidth="116.0" cellHeight="200.0" border="true">
    <style shadow="true" transparent="true">
     <color foreground="0xFF0066" background="0xFFFFFF" shadow="0xCCCCCC" inactive="0xFFFFFF" alternative="0xFFFFFF" />
    </style>
    <shaper class="@Rectangular" cols="6" rows="1" />
    <cell>
     <p>Nace en San Juan un 15 de febrero de 1811</p>
    </cell>
    <cell>
     <p>Emigra a Chile en 1831</p>
    </cell>
    <cell>
     <p>Vuelve a emigrar a Chile en 1851</p>
    </cell>
    <cell>
     <p>Es elegido Gobernador de San Juan en 1862</p>
    </cell>
    <cell>
     <p>Es nombrado Presidente de la Nación en 1868</p>
    </cell>
    <cell>
     <p>Muere en Asunción del Paraguay un 11 de septiembre de 1888, a los 77 años</p>
    </cell>
   </cells>
   <scramble times="31" />
  </activity>
