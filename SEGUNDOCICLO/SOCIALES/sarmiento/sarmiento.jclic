     </style>
     <p>Descubre la frase </p>
    </cell>
    <cell type="final">
     <style shadow="true">
      <font family="Arial" size="26" bold="true" />
      <color foreground="0x0066CC" shadow="0xFFFFFF" />
      <gradient source="0x00A3FF" dest="0xFFFFFF" angle="348" />
     </style>
     <p>¿Qué nos quiso decir con esta afirmación?</p>
    </cell>
   </messages>
   <settings margin="8" dragCells="true" report="true" reportActions="false">
    <helpWindow showSolution="true" />
