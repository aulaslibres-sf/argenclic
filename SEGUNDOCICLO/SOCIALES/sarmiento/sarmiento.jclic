  <activity class="@puzzles.ExchangePuzzle" name="02_frase" code="">
   <description />
   <messages>
    <cell type="initial">
     <style shadow="true">
      <font family="Arial" size="26" bold="true" />
      <color foreground="0x0066CC" background="0xFFFFFF" shadow="0xFFFFFF" />
