<?xml version="1.0" encoding="UTF-8"?>
<JClicProject name="adverbio" version="0.1.3">
 <settings>
  <title>Partes invariables de la oración</title>
  <revision description="Creación del paquete de actividades en Clic 3.0" date="6/13/03" />
  <revision description="Conversión de Clic3 a JClic" date="5/12/03">
   <author name="Equip Clic" mail="clic@xtec.cat" organization="Subdirecció General de Tecnologies de la Informació (SGTI)" />
  </revision>
  <author name="Míriam Castillo Castillo" mail="jmcaro@ctcinternet.cl" />
  <organization name="Escuela Cardenal José María Caro" url="http://www.ctio.noao.edu/AURA/redlaser/jmcaro/jmcaro.html" city="Coquimbo" country="Chile" />
  <language>español</language>
  <description>
   <p>Paquetes de actividades sobre las partes invariables de la oración gramatical. La aplicación se estructura en cuatro partes:</p>
   <p>&lt;UL&gt;</p>
   <p>&lt;LI&gt;Conjunciones</p>
   <p>&lt;LI&gt;Adverbios</p>
   <p>&lt;LI&gt;Preposiciones</p>
   <p>&lt;LI&gt;Interjecciones</p>
   <p>&lt;/UL&gt;</p>
  </description>
  <descriptors area="Lenguas" level="Primaria">aprendizaje de la lengua, lengua castellana</descriptors>
 </settings>
 <sequence>
  <item id="adverbio.pac" name="adverbio.ass">
   <jump action="RETURN" id="back" />
  </item>
  <item name="clasadv.ass" />
  <item name="reconadv.ass" />
  <item name="taverb.txa" />
  <item name="tielumod.ass" />
  <item name="tielumo.ass" />
  <item name="adjmente.ass" />
  <item name="uneadv.ass" />
  <item name="masadver.ass" />
  <item name="tmasadv.txa" />
  <item name="escribad.ass" />
  <item name="completa.ass" />
  <item name="masclas.ass" />
  <item name="locadv.ass" />
  <item name="unelocad.ass" />
  <item name="trozlocu.txa" />
  <item name="esclocuc.ass">
   <jump action="RETURN" id="forward" />
  </item>
 </sequence>
