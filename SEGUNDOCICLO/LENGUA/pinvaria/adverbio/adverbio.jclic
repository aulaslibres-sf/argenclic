  <activity class="@panels.InformationScreen" name="adverbio.ass">
   <description>
    <p>Pantalla de información</p>
   </description>
   <messages>
    <cell type="initial">
     <style>
      <font family="Times New Roman" size="30" bold="true" />
      <color foreground="0x804000" background="0xFFFF80" />
     </style>
     <p>Lee atentamente, copia o imprime.</p>
    </cell>
    <cell type="final">
     <style>
      <font family="Times New Roman" size="30" bold="true" />
      <color foreground="0x804000" background="0xFFFF80" />
     </style>
    </cell>
   </messages>
   <settings margin="8" report="false">
    <container bgColor="0xFF8080">
     <counters time="false" actions="false" score="false" />
    </container>
    <window bgColor="0xC0C0C0" border="true" />
   </settings>
   <cells rows="1" cols="1" cellWidth="700.0" cellHeight="500.0" border="true">
    <style>
     <font family="Times New Roman" size="30" bold="true" />
     <color foreground="0x804000" background="0xFFFF80" />
    </style>
    <shaper class="@Rectangular" cols="1" rows="1" />
    <cell>
     <p>EL ADVERBIO: Es una parte invariable de la oración gramatical, ya que no admite variación de género ni de núnero. El adverbio determina al núcleo del predicado.</p>
    </cell>
   </cells>
  </activity>
  <activity class="@panels.InformationScreen" name="clasadv.ass">
   <description>
    <p>Pantalla de información</p>
