   </cells>
   <cells rows="1" cols="6" cellWidth="120.0" cellHeight="120.0" border="true" id="answers">
    <style>
     <font family="Times New Roman" size="28" bold="true" />
     <color background="0xFFFFFF" />
    </style>
    <shaper class="@Rectangular" cols="6" rows="1" />
