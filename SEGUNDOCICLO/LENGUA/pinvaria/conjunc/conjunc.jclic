  <activity class="@text.Identify" name="tconjunc.txa" type="identifyWords">
   <description>
    <p>Actividad con evaluación final</p>
   </description>
   <messages>
    <cell type="initial">
     <style>
      <color foreground="0x800080" background="0xFFFFFF" />
     </style>
     <p>Marca todas las conjunciones que encuentres en este trozo.</p>
    </cell>
    <cell type="final">
     <style>
      <color foreground="0x800080" background="0xFFFFFF" />
     </style>
     <media type="PLAY_AUDIO" level="2" file="perfec.wav" />
     <p>¡Perfecto!</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <container bgColor="0xD9FFB3">
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xC0C0C0" border="true">
     <size width="520" height="346" />
    </window>
   </settings>
   <checkButton>Corregir el ejercicio</checkButton>
   <document>
    <style name="default" size="15" background="0xFFFFFF" family="Arial" bold="true" foreground="0x8000FF" italic="false" tabWidth="13" />
    <style name="target" base="default" target="true" background="0xFFFFFF" foreground="0xFF00FF" />
    <style name="targetError" base="target" background="0xFF0000" foreground="0xFFFFFF" />
    <section>
     <p>
      <cell width="490" height="50" border="true">
       <style>
        <font family="Times New Roman" size="27" bold="true" />
        <color foreground="0xFFFFFF" background="0x8080FF" inactive="0x000000" alternative="0x000000" />
       </style>
       <p>Encuentra en este trozo  conjunciones.</p>
      </cell>
     </p>
     <p>
      <text>           </text>
     </p>
     <p>
      <text>            "La historia de un  hombre </text>
      <target>que</target>
      <text> vivió hace miles de años".</text>
     </p>
     <p>
      <text>        Este hombre era muy pequeño, tenía cubiertos de largos pelos la cara </text>
      <target>y</target>
      <text> casi todo el cuerpo. Su frente era pequeña </text>
      <target>y</target>
      <text> su madíbula semejante a la quijada de los animales salvajes, </text>
      <target>que</target>
      <text> usaban los dientes como tenedor </text>
      <target>y</target>
      <text> como cuchillo. Se vestía, </text>
      <target>pero</target>
      <text> no llevaba ropa, </text>
      <target>sino</target>
      <text> cubría su cuerpo con pieles de animales, </text>
      <target>ya</target>
      <text> </text>
      <target>que</target>
      <text> vivía en la penumbra  de inmensos bosques. Cuando sentía hambre, comía raíces </text>
      <target>u</target>
      <text> hojas crudas </text>
      <target>o</target>
      <text> luchaba contra un ave, </text>
      <target>pero</target>
      <text> era muy astuto, </text>
      <target>porque</target>
      <text> le robaba los huevos de su nido. En el día vagaba en procura de alimentos </text>
      <target>o</target>
      <text> abrigos para su mujer </text>
      <target>y</target>
      <text> sus hijos.</text>
     </p>
     <p />
     <p>
      <text>-</text>
     </p>
     <p />
     <p />
     <p>
      <text>           </text>
     </p>
     <p />
     <p />
    </section>
   </document>
  </activity>
