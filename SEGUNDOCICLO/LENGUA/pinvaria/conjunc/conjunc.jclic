<?xml version="1.0" encoding="UTF-8"?>
<JClicProject name="conjunc" version="0.1.3">
 <settings>
  <title>Partes invariables de la oración</title>
  <revision description="Creación del paquete de actividades en Clic 3.0" date="6/13/03" />
  <revision description="Conversión de Clic3 a JClic" date="5/12/03">
   <author name="Equip Clic" mail="clic@xtec.cat" organization="Subdirecció General de Tecnologies de la Informació (SGTI)" />
  </revision>
  <author name="Míriam Castillo Castillo" mail="jmcaro@ctcinternet.cl" />
  <organization name="Escuela Cardenal José María Caro" url="http://www.ctio.noao.edu/AURA/redlaser/jmcaro/jmcaro.html" city="Coquimbo" country="Chile" />
  <language>español</language>
  <description>
   <p>Paquetes de actividades sobre las partes invariables de la oración gramatical. La aplicación se estructura en cuatro partes:</p>
   <p>&lt;UL&gt;</p>
   <p>&lt;LI&gt;Conjunciones</p>
   <p>&lt;LI&gt;Adverbios</p>
   <p>&lt;LI&gt;Preposiciones</p>
   <p>&lt;LI&gt;Interjecciones</p>
   <p>&lt;/UL&gt;</p>
  </description>
  <descriptors area="Lenguas" level="Primaria">aprendizaje de la lengua, lengua castellana</descriptors>
 </settings>
 <sequence>
  <item id="conjunc.pac" name="conjunc.ass" delay="5">
   <jump action="RETURN" id="back" />
  </item>
  <item name="perooey.ass" delay="5" />
  <item name="conjye.ass" delay="5" />
  <item name="conjou.ass" delay="5" />
  <item name="conjmps.ass" delay="5" />
  <item name="trozconj.txa" delay="5" />
  <item name="tconjunc.txa" delay="5">
   <jump action="RETURN" id="forward" />
  </item>
 </sequence>
 <activities>
  <activity class="@text.WrittenAnswer" name="conjmps.ass">
   <description>
    <p>Actividad de respuesta escrita</p>
   </description>
   <messages>
    <cell type="initial">
     <style>
      <font family="Times New Roman" size="28" bold="true" />
      <color background="0xFFFFFF" />
     </style>
     <p>¿Cuál conjunción se escribe?  mas -  pues -  porque -  sino -  e? </p>
    </cell>
    <cell type="final">
     <style>
      <font family="Times New Roman" size="28" bold="true" />
      <color background="0xFFFFFF" />
     </style>
     <media type="PLAY_AUDIO" level="2" file="perfec.wav" />
     <p>¡Perfecto!</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <helpWindow showSolution="true" />
    <container bgColor="0xFFFFFF">
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0x0080C0" border="true" />
   </settings>
   <cells rows="1" cols="4" cellWidth="120.0" cellHeight="120.0" border="true" id="primary">
    <style>
     <font family="Times New Roman" size="28" bold="true" />
     <color background="0xDBF3FF" />
    </style>
    <shaper class="@Rectangular" cols="4" rows="1" />
    <cell>
     <p>Lo haría, ... no me animo, ... amenaza una tormenta.</p>
    </cell>
    <cell>
     <p>Daniel ... Inés no corrieron, ... volaron a contar la noticia.</p>
    </cell>
    <cell>
     <p>No podré ir, ... mo me concedieron el permiso.</p>
    </cell>
    <cell>
     <p>He vuelto, ... quería verte llegar.</p>
    </cell>
   </cells>
   <cells rows="1" cols="4" cellWidth="120.0" cellHeight="120.0" border="true" id="answers">
    <style>
     <font family="Times New Roman" size="28" bold="true" />
     <color background="0xFFFFFF" />
    </style>
    <shaper class="@Rectangular" cols="4" rows="1" />
    <cell>
     <p>mas pues</p>
    </cell>
    <cell>
     <p>e sino</p>
    </cell>
    <cell>
     <p>pues</p>
    </cell>
    <cell>
     <p>porque</p>
    </cell>
   </cells>
   <scramble times="31" primary="true" />
   <layout position="AUB" />
  </activity>
