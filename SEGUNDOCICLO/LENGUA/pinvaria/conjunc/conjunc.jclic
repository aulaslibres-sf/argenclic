    <style name="target" base="default" target="true" background="0xFFFFFF" foreground="0xFF8040" />
    <style name="targetError" base="target" background="0xFF0000" foreground="0xFFFFFF" />
    <section>
     <p>
      <cell width="490" height="50" border="true">
       <style>
        <font family="Times New Roman" size="27" bold="true" />
        <color foreground="0xFFFFFF" background="0x008000" inactive="0x000000" alternative="0x000000" />
       </style>
       <p>Encuentra en estas oraciones conjunciones.</p>
      </cell>
     </p>
     <p>
      <text>           -</text>
     </p>
     <p />
     <p />
     <p>
      <text>           - Entramos </text>
      <target>y</target>
      <text> gozamos del espectáculo.</text>
     </p>
     <p>
      <text>           - Lo buscamos, </text>
      <target>mas</target>
      <text> no lo encontramos.</text>
     </p>
     <p>
      <text>           - Quédate aquí </text>
      <target>o</target>
      <text> te perderás.</text>
     </p>
     <p>
      <text>           - Fuimos al cine, </text>
      <target>pero</target>
      <text> no quedaban entradas.</text>
     </p>
     <p>
      <text>           - Pedro </text>
      <target>u</target>
      <text> Oscar actuarán mañana en la obra de teatro. </text>
