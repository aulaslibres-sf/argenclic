  <item name="sonido.ass" delay="3" />
  <item name="soni7.ass" delay="3" />
  <item name="soni8.ass" delay="3" />
  <item name="soni9.ass" delay="3" />
  <item name="soni10.ass" delay="3">
   <jump action="RETURN" id="forward" />
  </item>
 </sequence>
