<?xml version="1.0" encoding="UTF-8"?>
<JClicProject name="sonido" version="0.1.3">
 <settings>
  <title>Reconocimiento de sonidos</title>
  <revision description="Creación del paquete de actividades en Clic 3.0" date="7/24/98" />
  <revision description="Conversión de Clic3 a JClic" date="4/11/02">
   <author name="Equip Clic" mail="clic@xtec.cat" organization="Subdirecció General de Tecnologies de la Informació (SGTI)" />
  </revision>
  <author name="Celestino Arteta" mail="celestino@ctv.es" />
  <author name="Grupo de trabajo de logopedas" />
  <organization name="CAP Tafalla" mail="cap.tafalla@pnte.cfnavarra.es" city="Tafalla" state="Navarra" />
  <language>Español</language>
  <description>
   <p>Materiales de logopedia para trabajar la discriminación auditiva. Se presentan unos cuarenta sonidos que hay que identificar y asociar con las imágenes.</p>
  </description>
  <descriptors area="Diversos" level="Infantil, Primaria">comprensión oral, educación especial</descriptors>
 </settings>
 <sequence>
  <item id="sonido.pac" name="portada.ass" delay="3">
   <jump action="STOP" id="back" />
  </item>
  <item name="soni1.ass" delay="3" />
  <item name="soni2.ass" delay="3" />
  <item name="soni3.ass" delay="3" />
  <item name="soni4.ass" delay="3" />
  <item name="soni5.ass" delay="3" />
