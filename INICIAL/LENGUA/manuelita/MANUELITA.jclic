     <color foreground="0x00FF00" background="0x000000" inactive="0xFFFF00" alternative="0xFFFF00" />
    </style>
    <shaper class="@Rectangular" cols="3" rows="3" />
    <cell image="esce01_s.gif">
     <media type="RUN_CLIC_PACKAGE" level="1" file="escenes1.pac" />
    </cell>
    <cell image="esce02_s.gif">
     <media type="RUN_CLIC_PACKAGE" level="1" file="escenes2.pac" />
    </cell>
    <cell image="esce03_s.gif">
