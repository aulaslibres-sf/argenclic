<JClicProject name="manuel" version="0.1.3">
 <settings>
  <title>Manuelita</title>
  <revision description="created" date="12/17/04" />
  <author name="Placido Lutri" mail="placidol@hotmail.com" rol="Prof. de Informática" />
  <author name="Alumnos de 1º y 2º grado de EGB1" rol="coloreado de imágenes y producción de textos" />
  <organization name="Escuela &quot;Mariano Moreno&quot;" mail="marianomoreno_edu@hotmail.com" url="http://www.mmoreno.4t.com" city="Ciudad de Córdoba" country="Argentina" state="Córdoba" />
  <language>es</language>
  <description>
   <p>Paquete de actividades basado en la historia de la tortuga Manuelita, personaje creado por la escritora argentina María Elena Walsh. Contiene imágenes de la película del mismo nombre del cineasta argentino Aldo Ferrer.</p>
  </description>
  <descriptors area="Lengua" level="EGB1" />
  <meta_langs>es</meta_langs>
  <descriptions>
   <description language="es">
    <p>Paquete de actividades basado en la historia de la tortuga Manuelita, personaje creado por la escritora argentina María Elena Walsh. Contiene imágenes de la película del mismo nombre del cineasta argentino Aldo Ferrer.</p>
   </description>
  </descriptions>
  <license type="by-nc-sa" url="https://creativecommons.org/licenses/by-nc-sa/4.0" />
 </settings>
